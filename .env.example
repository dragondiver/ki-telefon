OPENAI_API_KEY=sk-...
KITELEFON_PLATFORM=mac
KITELEFON_DB_PATH=tasks.db
KITELEFON_LOG_LEVEL=INFO
KITELEFON_OPENAI_MODEL=gpt-realtime-2.1-mini
# Gedaechtnis pro Rolle (Fakten dauerhaft, letztes Gespraech 14 Tage).
# Braucht ANTHROPIC_API_KEY: nach jedem Anruf destilliert Claude daraus
# ein paar Saetze. Default aus.
KITELEFON_ROLE_MEMORY=false
# Server-VAD abstimmen, wenn das Telefon schlecht versteht oder sich
# nicht unterbrechen laesst. Niedriger = empfindlicher (tiefe/leise
# Stimmen), aber Gefahr, dass die KI ihr eigenes Uebersprechen hoert.
KITELEFON_VAD_THRESHOLD=0.6
KITELEFON_VAD_PREFIX_PADDING_MS=500
KITELEFON_VAD_SILENCE_MS=800
# Pi: deploy/kitelefon.service sets false (the handset isolates acoustically)
KITELEFON_HALF_DUPLEX=true
# mise-en-place shopping list integration (optional)
KITELEFON_MISE_EN_PLACE_URL=https://<deine-mise-en-place-instanz>
KITELEFON_MISE_EN_PLACE_SECRET=

# Freisprechen über Elektra (rundfunk, #38): Verleih-Endpunkt der Bridge
# und das Token, das dort als RUNDFUNK_AGENT_TOKEN steht. Beides leer =
# kein Freisprechen, das Gespräch bleibt im Hörer.
KITELEFON_RUNDFUNK_VERLEIH_URL=ws://agent-pi.local:8000/verleih
KITELEFON_RUNDFUNK_AGENT_TOKEN=

# Wohnort für "Wie ist das Wetter bei uns/hier?" (#141). Leer = keiner,
# get_weather braucht dann wie bisher einen genannten Ort.
# KITELEFON_WOHNORT=Musterstadt

# Anthropic Claude API (für serverseitige Rezept-Generierung etc.)
ANTHROPIC_API_KEY=sk-ant-...

# Spotify Connect (Evoke Play, Duo: zwei Konten)
# Aus dem Spotify Developer Dashboard. Redirect URI dort eintragen.
# Account-Vornamen kleingeschrieben — bestimmen Dateinamen token_<name>.json
# und werden im Gespräch ("Wer ist da?") für die Kontowahl genutzt.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_DEVICE_NAME=Evoke Play
# Zweiter Connect-Lautsprecher, erreichbar über spotify_play(geraet="anlage").
# Namensteil reicht, wie bei SPOTIFY_DEVICE_NAME.
SPOTIFY_DEVICE_NAME_ANLAGE=Anlage
SPOTIFY_ACCOUNT_1=konto1
SPOTIFY_ACCOUNT_2=konto2

# Namen aus dem Haushalt (#149), nicht im Code. Mail-Empfaenger unter
# Kurznamen, kommagetrennt; der erste ist der Hauptnutzer ("dich").
KITELEFON_PERSONEN=ich,partnerin

# Franzoesischkurs (Rolle 3, Paket sprachkurs)
# Eigene Datenbank fuer Fortschritt/Auswertungen; das sprachkurs-Paket
# liest diese Variable direkt aus der Umgebung (kein KITELEFON_-Praefix).
SPRACHKURS_DATABASE_URL=
# Realtime-Modell nur fuer Camille (Rolle 3), getrennt von
# KITELEFON_OPENAI_MODEL einstellbar; Default wie alle Rollen 2.1-mini.
KITELEFON_SPRACHKURS_MODEL=gpt-realtime-2.1-mini
# Auswertungs-Task in die Remote-Queue stellen. Aus, bis Plan 3 die
# konsument-Spalte im heim-agent liefert.
KITELEFON_SPRACHKURS_ENQUEUE=false
# Name der Lernenden im Sprachkurs. Fehlt er, startet der Kurs nicht
# und meldet das im Journal.
KITELEFON_SPRACHKURS_LERNENDE=

# Home Assistant: Anrufzaehler sensor.kitelefon_anrufe_heute (#69).
# Kein KITELEFON_-Praefix. Auf kitelefon stehen beide in /etc/pi-status.env
# (liest der systemd-Dienst per EnvironmentFile), hier also leer lassen.
# Fehlen sie, wird gezaehlt, aber nicht gemeldet.
HA_URL=
HA_TOKEN=
